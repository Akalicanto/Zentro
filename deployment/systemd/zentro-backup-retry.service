[Unit]
Description=Reintentar únicamente los correos pendientes de Zentro
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/zentro/deployment/backup.py --retry-only
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zentro/mail-backups
TimeoutStartSec=10min
