{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Zentro: Front + API + Swagger",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${env:ProgramFiles}/nodejs/node.exe",
      "program": "${workspaceFolder}/scripts/dev.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": false
    },
    {
      "name": "Zentro.Api: depurar C#",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Zentro: compilar API",
      "program": "${workspaceFolder}/Zentro.Api/bin/Debug/net10.0/Zentro.Api.dll",
      "cwd": "${workspaceFolder}/Zentro.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
